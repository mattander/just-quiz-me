{
  "name": "just-quiz-me",
  "version": "1.0.0",
  "description": "A TanStack Start app shell for Just Quiz Me on Cloudflare Workers.",
  "private": true,
  "scripts": {
    "cf:typegen": "wrangler types --env-interface CloudflareEnv",
    "content:validate": "node --experimental-strip-types ./scripts/validate-content.ts",
    "db:migrate:local": "wrangler d1 migrations apply QUIZ_DB --local",
    "content:sync:local": "node --experimental-strip-types ./scripts/sync-content.ts",
    "generate:routes": "node ./scripts/generate-routes.mjs",
    "build:css": "tailwindcss -i ./src/tailwind.source.css -o ./src/tailwind.css",
    "watch:css": "tailwindcss -i ./src/tailwind.source.css -o ./src/tailwind.css --watch",
    "dev": "npm run cf:typegen && npm run build:css && npm run generate:routes && concurrently \"npm run watch:css\" \"vite dev --port 3000\"",
    "build": "npm run cf:typegen && npm run build:css && npm run generate:routes && vite build",
    "typecheck": "npm run cf:typegen && npm run generate:routes && tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "cf:whoami": "wrangler whoami"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattander/just-quiz-me.git"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mattander/just-quiz-me/issues"
  },
  "homepage": "https://github.com/mattander/just-quiz-me#readme",
  "dependencies": {
    "@tailwindcss/cli": "^4.2.1",
    "@tanstack/react-form": "^1.28.5",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.166.7",
    "@tanstack/react-start": "^1.166.8",
    "concurrently": "^9.2.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "wrangler": "^4.73.0"
  }
}
